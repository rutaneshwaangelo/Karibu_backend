        {
          "name": "Live queue",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const d = res.data || {};",
                  "const entry = d.currentServing || (d.waitingList && d.waitingList[0]);",
                  "if (entry) pm.collectionVariables.set('queueEntryId', entry._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/business/queue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "business", "queue"]
            },
            "description": "currentServing, waitingList, recentlyCompleted (today, max 10). Saves an entry id to `queueEntryId` for cancel/adjust."
          },
          "response": []
