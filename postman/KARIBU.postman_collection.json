{
  "info": {
    "name": "KARIBU API",
    "description": "Smart Queue Management System API.\n\nSetup:\n1. Start the backend (`npm run dev`) and import this collection.\n2. Run \"Auth > Login (Admin)\" once — the `token` collection variable is filled automatically.\n3. Run requests top-to-bottom and IDs (categoryId, businessId, serviceId, staffId, queueId, queueEntryId, subscriptionId, userId) are captured from responses.\n\nChange `baseUrl` in the collection variables if the API is not on localhost:5000. For owner/staff-only folders, log in as that role first (the same `token` variable is reused).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "businessId", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "staffId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "queueId", "value": "" },
    { "key": "queueEntryId", "value": "" },
    { "key": "subscriptionId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Liveness check. Does not require a token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  console.log('Saved admin token');",
                  "}",
                  "pm.test('login succeeded', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"123karibu\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Seeded platform admin. Use john@kibalisalon.com / SalonPass2026! for the business owner and sarah@kibalisalon.com / StaffPass2026! for staff. The returned JWT is stored in `token`."
          },
          "response": []
        },
        {
          "name": "Login (Business Owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  if (res.user && res.user.businessId) pm.collectionVariables.set('businessId', res.user.businessId);",
                  "}",
                  "pm.test('login succeeded', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@kibalisalon.com\",\n  \"password\": \"SalonPass2026!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Overwrites `token` with an owner JWT. Needed for the Business and Services folders."
          },
          "response": []
        },
        {
          "name": "Login (Staff)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  if (res.user && res.user.businessId) pm.collectionVariables.set('businessId', res.user.businessId);",
                  "}",
                  "pm.test('login succeeded', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah@kibalisalon.com\",\n  \"password\": \"StaffPass2026!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Overwrites `token` with a staff JWT. Needed for the Staff folder."
          },
          "response": []
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Returns the user behind the current `token`, including the populated business."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Stateless: always 200. The client must discard the token."
          },
          "response": []
        }
      ]
    },
